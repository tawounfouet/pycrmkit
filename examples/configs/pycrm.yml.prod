version: "1.0"

runtime:
  actor_id: "production-system@webtech.agency"
  environment: "production"

database:
  backend: "postgresql"
  url: "${DATABASE_URL}"
  pool_size: 20
  max_overflow: 40
  echo: false

integrations:
  email:
    provider: "resend"
    api_key_env: "RESEND_API_KEY"
    default_sender: "notifications@webtech.agency"

  webhooks:
    signing_secret_env: "CRM_SIGNING_SECRET"

cli:
  format: "rich"
