# ==============================================================================
# PyCRMKit — Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# All variables defined here are automatically loaded by the PyCRMKit CLI (`pck`),
# tests, and migration commands without requiring manual shell `export`.
# ==============================================================================

# Database Persistence Engine (PostgreSQL)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+psycopg:///pycrm"
PYCRMKIT_DATABASE_URL="postgresql+psycopg:///pycrm"

# Audit Trail & Actor Identity
CRM_ACTOR_ID="thomas@webtech.agency"

# Webhooks & Security (HMAC verification)
CRM_SIGNING_SECRET="dev-crm-signing-secret-key-32chars"

# Communication & Email Providers (Resend)
RESEND_API_KEY="re_dev_placeholder_api_key"
CRM_EMAIL_SENDER="contact@webtech.agency"

# Active Environment Profile (optional: dev | stg | prod)
# PYCRMKIT_ENV="dev"

# Declarative YAML Configuration Override (optional)
# PYCRMKIT_CONFIG="pycrm.yml"

# CLI Local Pickle State File (optional override)
# PYCRMKIT_CLI_STATE_FILE="/Users/awf/.pycrmkit/crm_state.pickle"
